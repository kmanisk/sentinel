# Runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://sentinel:sentinel_secret@localhost:5432/sentinel_db?schema=public
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret
POSTGRES_DB=sentinel_db

# Authentication
JWT_SECRET=replace_this_with_a_secure_random_hex_key_in_production_min_32_chars

# Optional OAuth providers
# Google callback: ${APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub callback: ${APP_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Self-hosted HTTPS
DOMAIN_NAME=sentinel-demo.duckdns.org
ACME_EMAIL=your-email@example.com
