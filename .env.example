# ==============================================================================
# Sentinel Environment Configuration
# ==============================================================================

# Server Network & Runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://sentinel:sentinel_secret@localhost:5432/sentinel_db?schema=public

# Database Container Defaults (used by docker-compose)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret
POSTGRES_DB=sentinel_db

# Security & Authentication
JWT_SECRET=replace_this_with_a_secure_random_hex_key_in_production_min_32_chars

# Production Domain & Automated HTTPS (Caddy + DuckDNS / Custom Domain)
# Example DuckDNS: sentinel-demo.duckdns.org
DOMAIN_NAME=sentinel-demo.duckdns.org
ACME_EMAIL=your-email@example.com
